# TRANZIQ configuration. Copy to ".env" and adjust if needed - every value is optional.
# No API keys or paid services are required.

# SQLite database file (default: data/tranziq.db)
# TRANZIQ_DATABASE_URL=sqlite:///data/tranziq.db

# Where the Kaggle CSV lives (default: data/raw/creditcard.csv)
# TRANZIQ_DATASET_PATH=data/raw/creditcard.csv

# Where trained models / reports / plots are written (default: artifacts)
# TRANZIQ_ARTIFACTS_DIR=artifacts

# Frontend origins allowed to call the API
TRANZIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the demo database on first start (true/false)
TRANZIQ_AUTO_SEED=true
# Legitimate Kaggle TEST records stored on first start (all test-set frauds are always included)
TRANZIQ_SEED_LEGIT_SAMPLE=4000
# Synthetic demo transactions created on first start
TRANZIQ_SEED_SYNTHETIC=300

# Max rows accepted in one CSV upload
TRANZIQ_MAX_UPLOAD_ROWS=5000

# Test rows used to compute global SHAP importance during training
TRANZIQ_SHAP_SAMPLE=400
