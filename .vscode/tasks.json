{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TRANZIQ: API (FastAPI :8000)",
      "type": "shell",
      "windows": { "command": "..\\.venv\\Scripts\\uvicorn app.main:app --reload --port 8000" },
      "command": "../.venv/bin/uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TRANZIQ: Web (Vite :5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TRANZIQ: Start everything",
      "dependsOn": ["TRANZIQ: API (FastAPI :8000)", "TRANZIQ: Web (Vite :5173)"],
      "problemMatcher": []
    },
    {
      "label": "TRANZIQ: Train models",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python backend\\scripts\\train_models.py" },
      "command": ".venv/bin/python backend/scripts/train_models.py",
      "problemMatcher": []
    },
    {
      "label": "TRANZIQ: Run tests",
      "type": "shell",
      "windows": { "command": "..\\.venv\\Scripts\\python -m pytest" },
      "command": "../.venv/bin/python -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
